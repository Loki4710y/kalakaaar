# Copy to .env.local (never commit .env.local)

# Supabase -> Project Settings -> API. Both are PUBLIC-safe (security comes from Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL: canonical links, sitemap, robots, social previews.
# REQUIRED for a production build (the build stops if it is missing or not https). Use your real domain, no trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NEVER put the Supabase service_role key in this app.

# Optional: privacy-friendly analytics (plausible.io). Leave empty to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Optional: error tracking (sentry.io -> new project -> Browser JavaScript -> copy the DSN). Leave empty to disable.
NEXT_PUBLIC_SENTRY_DSN=

# Optional bot protection on signup (Cloudflare Turnstile, free). Site key only; the secret key goes in
# Supabase Dashboard > Authentication > Attack Protection > Enable CAPTCHA (never in this app).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
